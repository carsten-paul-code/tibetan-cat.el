    ;; Format: present / past / future / imperative

    ;; བྱེད་ - to do/make (transitive)
    (puthash "བྱེད" '((lemma . "བྱེད")
                     (meaning . "to do, to make")
                     (present_stem . "བྱེད")
                     (past_stem . "བྱས")
                     (future_stem . "བྱ")
                     (imperative_stem . "བྱོས")
                     (transitivity . "Transitive")
                     (volitionality . "Volitional")
                     (case_frame . "Erg-Abs")
                     (indigenous_class . "tha_dad_pa")) db)
    (puthash "བྱས" (gethash "བྱེད" db) db)
    (puthash "བྱ" (gethash "བྱེད" db) db)
    (puthash "བྱོས" (gethash "བྱེད" db) db)


;;; tibetan-verb-classifier.el --- Tibetan verb classification (Hill 2010) -*- lexical-binding: t -*-

;;; Commentary:
;; Provides verb lookup and classification based on Nathan Hill's
;; "A Lexicon of Tibetan Verb Stems as Reported by the Grammatical Tradition" (2010).
;;
;; Features:
;; - Verb stem recognition (present, past, future, imperative)
;; - Transitivity classification (transitive/intransitive)
;; - Volitionality classification (volitional/non-volitional)
;; - Case frame analysis (ERG-ABS, ABS, etc.)
;; - Indigenous class (tha dad pa / tha mi dad pa)

;;; Code:

(require 'cl-lib)

;; ============================================================================
;; VERB DATABASE
;; Based on Hill 2010 and common classical Tibetan verbs
;; Format: (lemma . properties-alist)
;; ============================================================================

(defvar tibetan-verb-database
